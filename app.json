{
  "expo": {
    "name": "Buku Tamu Desa",
    "slug": "DesaGuestBook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Lambang_Kabupaten_Banyumas.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/Lambang_Kabupaten_Banyumas.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Lambang_Kabupaten_Banyumas.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.desaguestbook.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan aplikasi mengakses galeri untuk upload foto tamu.",
          "cameraPermission": "Izinkan aplikasi mengakses kamera untuk memotret tamu."
        }
      ]
    ]
  }
}